{
  "name": "meridian-iam-range",
  "version": "1.1.1",
  "type": "module",
  "description": "Meridian IAM Range: a simulated Windows workstation for practising healthcare identity and access management.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build:web": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build --base=/lab/ --outDir ../site/lab --emptyOutDir",
    "build:icons": "node build-icons.cjs && node build-installer-art.cjs",
    "electron:dev": "npm run build && node node_modules/electron/cli.js electron/main.cjs",
    "build:desktop": "npm run build && npm run build:icons && node node_modules/electron-builder/cli.js --win --publish never",
    "release": "npm run build:web && npm run build && npm run build:icons && node node_modules/electron-builder/cli.js --win --publish always"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "productName": "Meridian IAM Range",
  "author": {
    "name": "Erick Omari"
  },
  "license": "MIT",
  "homepage": "https://github.com/pitchiluxe/identityforge-iam-lab",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mydigitalsolutions.meridianiamrange",
    "productName": "Meridian IAM Range",
    "copyright": "Copyright (c) 2026 Erick Omari",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE.txt"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pitchiluxe",
        "repo": "identityforge-iam-lab",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Meridian-IAM-Range-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meridian IAM Range",
      "menuCategory": "Meridian IAM Range",
      "license": "LICENSE.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "1033",
      "uninstallDisplayName": "Meridian IAM Range ${version}"
    }
  }
}
